<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ============================================================ header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ============================================================ car -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_car" />

                <TextView
                    android:id="@+id/car_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/car_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/car_remote"
                        style="@style/RowButton"
                        android:text="@string/action_remote" />

                    <Button
                        android:id="@+id/car_home"
                        style="@style/RowButton"
                        android:text="@string/action_home" />

                    <Button
                        android:id="@+id/car_reload"
                        style="@style/RowButton"
                        android:text="@string/action_reload" />

                    <Button
                        android:id="@+id/car_rebuild"
                        style="@style/RowButton"
                        android:text="@string/action_rebuild" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ============================================================ account -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_account" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signin_help"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Button
                    android:id="@+id/activate"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_activate" />

                <TextView
                    style="@style/Label"
                    android:text="@string/cookies" />

                <LinearLayout
                    android:id="@+id/cookie_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cookie_export"
                        style="@style/RowButton"
                        android:text="@string/cookie_export" />

                    <Button
                        android:id="@+id/cookie_import"
                        style="@style/RowButton"
                        android:text="@string/cookie_import" />

                    <Button
                        android:id="@+id/cookie_clear_all"
                        style="@style/RowButton"
                        android:text="@string/sign_out"
                        android:textColor="?attr/colorError" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ display -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_display" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="0dp"
                    android:text="@string/refresh_rate" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/refresh_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/refresh_auto"
                        style="@style/ToggleButton"
                        android:text="@string/refresh_auto" />

                    <Button
                        android:id="@+id/refresh_24"
                        style="@style/ToggleButton"
                        android:text="24" />

                    <Button
                        android:id="@+id/refresh_30"
                        style="@style/ToggleButton"
                        android:text="30" />

                    <Button
                        android:id="@+id/refresh_60"
                        style="@style/ToggleButton"
                        android:text="60" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    style="@style/Hint"
                    android:text="@string/refresh_hint" />

                <TextView
                    android:id="@+id/swipe_step_label"
                    style="@style/Label" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/swipe_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="10"
                    android:valueFrom="40"
                    android:valueTo="400"
                    app:tickVisible="false" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/swipe_step_hint" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pre_raster"
                    style="@style/Switch"
                    android:text="@string/pre_raster" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/keep_awake"
                    style="@style/Switch"
                    android:text="@string/keep_awake" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/keep_awake_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ advanced -->

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/section_advanced" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/custom_ua_layout"
                    style="@style/Field"
                    android:layout_marginTop="0dp"
                    android:hint="@string/custom_ua_hint"
                    app:endIconContentDescription="@string/apply"
                    app:endIconDrawable="@drawable/ic_check"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/custom_ua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textNoSuggestions|textMultiLine"
                        android:maxLines="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/ua_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inject_js_layout"
                    style="@style/Field"
                    android:hint="@string/inject_js_hint"
                    app:endIconContentDescription="@string/apply"
                    app:endIconDrawable="@drawable/ic_check"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inject_js"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="top"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="3"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Hint"
                    android:text="@string/inject_js_help" />

                <TextView
                    style="@style/Label"
                    android:text="@string/adb_title" />

                <TextView
                    android:id="@+id/adb_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceContainerHighest"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/reset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/reset_defaults"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
